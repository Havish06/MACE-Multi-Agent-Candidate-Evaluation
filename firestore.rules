rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check authentication
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles can only be read and updated by their owner
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Evaluations can be read by authenticated users, and written by their owner or authenticated evaluators
    match /evaluations/{evaluationId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || request.auth.token.admin == true);
    }
  }
}
